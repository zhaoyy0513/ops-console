# Ops Console 环境参数模板：复制为 .env 并填入真实值（.env 已 gitignore，不入库）
# 这一份同时服务：本地开发（uv run --env-file .env ...）与容器部署（compose 自动读取）

# 宿主机端口（默认 8090，避开现有 nginx 的 80）
OPS_PORT=8090

# 平台 Redis（配置 + 缓存 + 锁 + 操作日志），建议独立 DB（PRD §6.1）
OPS_REDIS_URL=redis://<host>:6379/5
OPS_LOG_LEVEL=INFO

# 外部系统超时（秒，可选，默认值见 backend/app/core/config.py）
# SSH_CONNECT_TIMEOUT=5
# SSH_COMMAND_TIMEOUT=10
# HTTP_CONNECT_TIMEOUT=5
# HTTP_READ_TIMEOUT=10
# REDIS_CONNECT_TIMEOUT=5
# MQ_API_TIMEOUT=10

# ---- 现场外部系统（仅 E2E 脚本 scripts/e2e_live.py 使用，可选）----
# ARTEMIS_URI=<host>
# ARTEMIS_USER_NAME=<user>
# ARTEMIS_PASSOWRD=<password>
# SERVER_IP=<host>
# SERVER_SSH_USER_NAME=<user>
# SERVER_SSH_PASSWORD=<password>
