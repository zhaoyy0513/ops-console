# Ops Console 部署（PRD §25）：backend + 平台自有 ops-nginx，复用现有 Redis。
# 复制为 .env 并按现场调整。启动：docker compose up -d

# 宿主机端口（默认 8090，避开现有 nginx 的 80）
OPS_PORT=8090

# 平台 Redis（配置 + 缓存 + 锁 + 操作日志），建议独立 DB
OPS_REDIS_URL=redis://10.0.0.1:6379/5
OPS_LOG_LEVEL=INFO

# 外部系统超时（秒，可选）
SSH_CONNECT_TIMEOUT=5
SSH_COMMAND_TIMEOUT=10
HTTP_CONNECT_TIMEOUT=5
HTTP_READ_TIMEOUT=10
REDIS_CONNECT_TIMEOUT=5
MQ_API_TIMEOUT=10
