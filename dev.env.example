# 本地开发环境变量模板：复制为 dev.env 并填入真实值（dev.env 已 gitignore，不入库）

# 平台 Redis（配置 + 缓存 + 锁 + 操作日志），建议独立 DB（PRD §6.1）
OPS_REDIS_URL=redis://<host>:6379/5

# 外部系统超时（秒，可选，默认值见 backend/app/core/config.py）
# SSH_CONNECT_TIMEOUT=5
# SSH_COMMAND_TIMEOUT=10
# HTTP_CONNECT_TIMEOUT=5
# HTTP_READ_TIMEOUT=10
# REDIS_CONNECT_TIMEOUT=5
# MQ_API_TIMEOUT=10
