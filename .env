# Ops Console 统一环境参数：本地开发与 Docker Compose 共用这一份（勿提交）
# 本地开发：uv run --env-file .env uvicorn backend.app.main:app --host 0.0.0.0 --port 25088
# 前端启动：npm run dev -- --host 0.0.0.0
# 容器部署：docker compose up -d --build （compose 自动读取本文件）

# 宿主机端口（默认 25089，避开现有 nginx 的 80）
OPS_PORT=25089

# 平台 Redis（配置 + 缓存 + 锁 + 操作日志），建议独立 DB
OPS_REDIS_URL=redis://10.102.129.50:6379/5
OPS_LOG_LEVEL=INFO

# 外部系统超时（秒，可选）
SSH_CONNECT_TIMEOUT=5
SSH_COMMAND_TIMEOUT=10
HTTP_CONNECT_TIMEOUT=5
HTTP_READ_TIMEOUT=10
REDIS_CONNECT_TIMEOUT=5
MQ_API_TIMEOUT=10

# ---- 现场外部系统（E2E 脚本 / 现场配置参考；平台代码只读上面 OPS_*/超时项）----
ARTEMIS_URI=10.102.129.12
ARTEMIS_USER_NAME=prime_admin
ARTEMIS_PASSOWRD=hElloPr1me
SERVER_IP=10.102.129.12
SERVER_SSH_USER_NAME=szsit
SERVER_SSH_PASSWORD=R00t0755
